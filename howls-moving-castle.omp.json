{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Shell }} ✦ {{ .Folder }}",
  "palette": {
    "calcifer": "#FF8C42",
    "ember": "#E76F51",
    "flame_yellow": "#FFD97D",
    "castle_rust": "#A0522D",
    "castle_teal": "#2A9D8F",
    "deep_teal": "#1F6F63",
    "sky": "#7EC8E3",
    "meadow": "#90BE6D",
    "twilight": "#6D597A",
    "sophie_silver": "#D9D4CE",
    "cream": "#FDF6E3",
    "ink": "#2B2118",
    "night": "#2E2A3B"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:ink",
          "background": "p:flame_yellow",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:cream",
          "background": "p:castle_teal",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "",
            "home_icon": "",
            "folder_separator_icon": "  "
          },
          "template": "  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:ink",
          "background": "p:meadow",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:flame_yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:ember{{ end }}",
            "{{ if gt .Ahead 0 }}p:sky{{ end }}",
            "{{ if gt .Behind 0 }}p:twilight{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " "
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "invert_powerline": true,
          "foreground": "p:cream",
          "background": "p:deep_teal",
          "template": "  {{ .Full }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "invert_powerline": true,
          "foreground": "p:ink",
          "background": "p:flame_yellow",
          "template": "  {{ .Full }} "
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "",
          "invert_powerline": true,
          "foreground": "p:ink",
          "background": "p:sky",
          "template": "  {{ .Full }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:cream",
          "background": "p:twilight",
          "properties": {
            "time_format": "15:04"
          },
          "template": "  {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:calcifer",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:ember{{ end }}"
          ],
          "template": " "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:sophie_silver",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:ember{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "{{ if gt .Code 0 }} {{ .Code }} {{ end }}🏰 > "
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:calcifer",
    "background": "transparent",
    "template": " 🏰 > "
  },
  "secondary_prompt": {
    "foreground": "p:sophie_silver",
    "background": "transparent",
    "template": " 🏰 > "
  },
  "tooltips": [
    {
      "type": "git",
      "tips": ["git", "g"],
      "style": "diamond",
      "leading_diamond": "",
      "trailing_diamond": "",
      "foreground": "p:ink",
      "background": "p:meadow",
      "properties": {
        "fetch_status": true,
        "branch_icon": " "
      },
      "template": " {{ .HEAD }} "
    }
  ]
}
